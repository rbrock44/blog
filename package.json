{
  "name": "blog",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "posts:build": "node scripts/buildPosts.js",
    "prestart": "npm run posts:build",
    "start": "ng serve",
    "prebuild": "npm run posts:build",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run posts:build",
    "test": "ng test",
    "gh-pages": "gh-pages -d dist/blog/browser",
    "predeploy": "npm run posts:build",
    "deploy": "ng build --configuration production",
    "prod": "npm run deploy && npm run gh-pages"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-server": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/ssr": "^22.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "gh-pages": "^6.3.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "satori": "^0.63.2",
    "shiki": "^4.6.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
