{
  "name": "blog",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "posts:build": "node scripts/buildPosts.js",
    "prestart": "npm run posts:build",
    "start": "ng serve",
    "prebuild": "npm run posts:build",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run posts:build",
    "test": "ng test",
    "gh-pages": "gh-pages -d dist/blog/browser",
    "deploy": "ng build --configuration production",
    "prod": "npm run deploy && npm run gh-pages"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.0",
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.17.19",
    "gray-matter": "^4.0.3",
    "jsdom": "^28.0.0",
    "marked": "^18.0.9",
    "prettier": "^3.8.1",
    "satori": "^0.29.0",
    "shiki": "^4.4.3",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
